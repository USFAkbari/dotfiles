**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/id_ecdsa
**/id_ecdsa.*
**/known_hosts
**/authorized_keys
**/.env
**/.env.*
**/.netrc
**/.npmrc
**/.pypirc
**/.git-credentials
**/.docker/config.json
.ssh
.gnupg
.aws
.kube/config
.config/gh/hosts.yml
